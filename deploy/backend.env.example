# 激活生产配置
SPRING_PROFILES_ACTIVE=prod

# MySQL
MYSQL_URL=jdbc:mysql://127.0.0.1:3306/wifi?useUnicode=true&characterEncoding=utf-8&serverTimezone=Asia/Shanghai&useSSL=false
MYSQL_USERNAME=wifi_app
MYSQL_PASSWORD=CHANGE_ME_MYSQL_PASSWORD

# Flyway：正常部署必须保持 false
DB_MIGRATION_URL=jdbc:mysql://127.0.0.1:3306/wifi?useUnicode=true&characterEncoding=utf-8&serverTimezone=Asia/Shanghai&useSSL=false
DB_MIGRATION_USERNAME=wifi_migration
DB_MIGRATION_PASSWORD=CHANGE_ME_MIGRATION_PASSWORD
DB_MIGRATION_BASELINE_ON_MIGRATE=false

# Nacos。生产环境必须先在所有 Nacos 节点开启鉴权；鉴权关闭时用户名和密码不会保护配置。
NACOS_SERVER_ADDR=127.0.0.1:8848
NACOS_USERNAME=nacos
NACOS_PASSWORD=CHANGE_ME_NACOS_PASSWORD
NACOS_NAMESPACE=
NACOS_GROUP=DEFAULT_GROUP
NACOS_DISCOVERY_IP=CHANGE_ME_PRIVATE_IP

# JWT 只允许配置在 Nacos 的 wifi-jwt.yml；不要在环境变量中设置 JWT_SECRET。
# 服务间安全配置
WIFI_GATEWAY_TOKEN=CHANGE_ME_RANDOM_GATEWAY_TOKEN_AT_LEAST_16_BYTES
WIFI_INTERNAL_TOKEN=CHANGE_ME_RANDOM_INTERNAL_TOKEN_AT_LEAST_16_BYTES

# P-2 认证会话。Access JWT 的 15 分钟期限固定在 Nacos wifi-jwt.yml。
WIFI_REFRESH_ABSOLUTE_TTL=7d
WIFI_OPERATION_TOKEN_TTL=5m
WIFI_REFRESH_COOKIE_NAME=wifi_refresh
WIFI_REFRESH_COOKIE_PATH=/
WIFI_REFRESH_COOKIE_SAME_SITE=Strict
WIFI_REFRESH_COOKIE_SECURE=true
# 旧 JWT 灰度窗口必须是明确的 UTC 截止时间；默认值表示不接受旧 Token。
WIFI_JWT_LEGACY_ACCEPT_UNTIL=1970-01-01T00:00:00Z
WIFI_CONTEXT_VALIDATION_TIMEOUT_MILLIS=2000
WIFI_CONTEXT_READ_CACHE_MILLIS=5000
WIFI_CONTEXT_CACHE_MAX_ENTRIES=4096

# Gateway 与浏览器来源
WIFI_ALLOWED_ORIGIN=https://your-frontend.example.com
WIFI_ALLOWED_ORIGIN_ALT=https://your-portal.example.com
WIFI_ALLOWED_ORIGINS=https://your-frontend.example.com,https://your-portal.example.com
WIFI_ALERT_HEARTBEAT_INTERVAL_MILLIS=25000
OAUTH_ALLOWED_RETURN_ORIGIN=https://your-frontend.example.com
OAUTH_ALLOWED_RETURN_ORIGIN_ALT=https://your-portal.example.com
FORWARD_HEADERS_STRATEGY=none
WIFI_TRUST_PROXY_HEADERS=true

# Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD
REDIS_DATABASE=0
REDIS_SSL=false
REDIS_RATE_LIMIT_ENABLED=true

# MQTT：每个 device-service 实例必须使用不同 client-id
MQTT_BROKER_URL=tcp://127.0.0.1:1883
MQTT_CLIENT_ID=device-service-instance-1
MQTT_USERNAME=
MQTT_PASSWORD=

# Base64 编码的 32 字节 AES 密钥；明确留空会禁用敏感 WiFi 配置命令
WIFI_COMMAND_SECRET_KEY=CHANGE_ME_BASE64_32_BYTE_AES_KEY

# Portal Session、租约和客户端信号时效
WIFI_PORTAL_CLIENT_SIGNAL_MAX_AGE_SECONDS=30
WIFI_PORTAL_LEASE_TTL_SECONDS=20
WIFI_PORTAL_SESSION_OFFLINE_TIMEOUT_SECONDS=30
WIFI_PORTAL_LEASE_SCHEDULER_ENABLED=true
WIFI_PORTAL_LEASE_SCAN_INTERVAL_MS=10000
WIFI_PORTAL_LEASE_INITIAL_DELAY_MS=10000

# 设备命令发布、终态和调度
WIFI_COMMAND_PUBLISH_MAX_ATTEMPTS=3
WIFI_COMMAND_PUBLISH_RETRY_DELAY_SECONDS=3
WIFI_COMMAND_RESULT_TIMEOUT_SECONDS=15
WIFI_COMMAND_SCHEDULER_ENABLED=true
WIFI_COMMAND_SCAN_BATCH_SIZE=50
WIFI_COMMAND_DISPATCH_SCAN_INTERVAL_MS=1000
WIFI_COMMAND_TIMEOUT_SCAN_INTERVAL_MS=1000
WIFI_COMMAND_SCHEDULER_INITIAL_DELAY_MS=5000

# 设备心跳
WIFI_DEVICE_HEARTBEAT_TIMEOUT_SECONDS=60
WIFI_DEVICE_HEARTBEAT_SCAN_INTERVAL_MS=10000
WIFI_DEVICE_HEARTBEAT_SCHEDULER_ENABLED=true

# 位置上报和 GIS 查询上限
WIFI_LOCATION_MINIMUM_REPORT_INTERVAL_SECONDS=3
WIFI_LOCATION_MAXIMUM_SPEED_METERS_PER_SECOND=100
WIFI_GIS_MAXIMUM_QUERY_POINTS=5000
WIFI_GIS_MAXIMUM_QUERY_DAYS=7

# 邮件验证码，可选
MAIL_HOST=smtp.qq.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=

# 手机验证码，可选：aliyun-number-auth 或 local
PHONE_VERIFICATION_PROVIDER=aliyun-number-auth
ALIYUN_PHONE_AUTH_ACCESS_KEY_ID=
ALIYUN_PHONE_AUTH_ACCESS_KEY_SECRET=
ALIYUN_PHONE_AUTH_ENDPOINT=dypnsapi.aliyuncs.com
ALIYUN_PHONE_AUTH_SCHEME_NAME=
ALIYUN_PHONE_AUTH_SIGN_NAME=
ALIYUN_PHONE_AUTH_TEMPLATE_CODE=100001

# OAuth Redirect URI 必须指向前端回调页，并与 Provider 控制台登记值完全一致
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_REDIRECT_URI=https://your-frontend.example.com/oauth-complete/github
QQ_OAUTH_CLIENT_ID=
QQ_OAUTH_CLIENT_SECRET=
QQ_OAUTH_REDIRECT_URI=https://your-frontend.example.com/oauth-complete/qq
WECHAT_OAUTH_CLIENT_ID=
WECHAT_OAUTH_CLIENT_SECRET=
WECHAT_OAUTH_REDIRECT_URI=https://your-frontend.example.com/oauth-complete/wechat

# Demo 支付与文件存储
WIFI_PAYMENT_DEFAULT_CHANNEL=LOCAL_DEMO
WIFI_PAYMENT_CALLBACK_WINDOW_SECONDS=300
WIFI_PAYMENT_LOCAL_DEMO_SECRET=CHANGE_ME_LOCAL_DEMO_PAYMENT_SECRET
WIFI_AVATAR_DIR=/opt/wifi-manager/data/avatars
