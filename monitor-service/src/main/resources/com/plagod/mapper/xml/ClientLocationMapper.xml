<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.plagod.mapper.ClientLocationMapper">

    <resultMap id="clientLocationResultMap" type="com.plagod.entity.monitor.ClientLocation">
        <id column="id" property="id"/>
        <result column="tenant_id" property="tenantId"/>
        <result column="mac" property="mac"/>
        <result column="user_id" property="userId"/>
        <result column="session_id" property="sessionId"/>
        <result column="node_id" property="nodeId"/>
        <result column="device_code" property="deviceCode"/>
        <result column="trusted_binding" property="trustedBinding"/>
        <result column="latitude" property="latitude"/>
        <result column="longitude" property="longitude"/>
        <result column="accuracy" property="accuracy"/>
        <result column="consent_time" property="consentTime"/>
        <result column="report_time" property="reportTime"/>
        <result column="source" property="source"/>
        <result column="remark" property="remark"/>
        <result column="create_time" property="createTime"/>
    </resultMap>

    <select id="selectTrustedPointsForGis" resultMap="clientLocationResultMap">
        select *
        from t_client_location
        <where>
            trusted_binding = 1
            and report_time <![CDATA[ >= ]]> #{startTime}
            and report_time <![CDATA[ <= ]]> #{endTime}

            <if test="sessionId != null">
                and session_id = #{sessionId}
            </if>
            <if test="userId != null">
                and user_id = #{userId}
            </if>
            <if test="nodeId != null">
                and node_id = #{nodeId}
            </if>
            <if test="mac != null and mac != ''">
                and mac = #{mac}
            </if>
        </where>
        order by report_time asc, id asc
        limit #{limit}
    </select>

    <select id="selectTrustedPointsForGisByTenant" resultMap="clientLocationResultMap">
        select *
        from t_client_location
        <where>
            tenant_id = #{tenantId}
            and trusted_binding = 1
            and report_time <![CDATA[ >= ]]> #{startTime}
            and report_time <![CDATA[ <= ]]> #{endTime}

            <if test="sessionId != null">
                and session_id = #{sessionId}
            </if>
            <if test="userId != null">
                and user_id = #{userId}
            </if>
            <if test="nodeId != null">
                and node_id = #{nodeId}
            </if>
            <if test="mac != null and mac != ''">
                and mac = #{mac}
            </if>
        </where>
        order by report_time asc, id asc
        limit #{limit}
    </select>

</mapper>
