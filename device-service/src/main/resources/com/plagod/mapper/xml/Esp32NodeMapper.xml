<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.plagod.mapper.Esp32NodeMapper">

    <resultMap id="Esp32NodeResultMap" type="com.plagod.entity.device.Esp32Node">
        <id property="nodeId" column="node_id" />
        <result property="tenantId" column="tenant_id" />
        <result property="creatorUserId" column="creator_user_id" />
        <result property="clientRequestId" column="client_request_id" />
        <result property="requestFingerprint" column="request_fingerprint" />
        <result property="quotaReservationReference" column="quota_reservation_reference" />
        <result property="deviceCode" column="device_code" />
        <result property="name" column="name" />
        <result property="location" column="location" />
        <result property="latitude" column="latitude" />
        <result property="longitude" column="longitude" />
        <result property="ip" column="ip" />
        <result property="firmwareVersion" column="firmware_version" />
        <result property="wifiStatus" column="wifi_status" />
        <result property="status" column="status" />
        <result property="maxClients" column="max_clients" />
        <result property="currentClients" column="current_clients" />
        <result property="version" column="version" />
        <result property="lastHeartbeat" column="last_heartbeat" />
        <result property="rssiAtOneMeter" column="rssi_at_one_meter" />
        <result property="pathLossExponent" column="path_loss_exponent" />
        <result property="createTime" column="create_time" />
        <result property="updateTime" column="update_time" />
        <result property="delFlag" column="del_flag" />
    </resultMap>

    <select id="selectByDeviceCodeIncludeDeleted" resultMap="Esp32NodeResultMap">
        select *from t_esp32_node where device_code = #{deviceCode} limit 1
    </select>

    <select id="selectByDeviceCodeAndTenantIncludeDeleted" resultMap="Esp32NodeResultMap">
        select * from t_esp32_node where tenant_id = #{tenantId} and device_code = #{deviceCode} limit 1
    </select>

    <select id="selectByNodeIdIncludeDeleted" resultMap="Esp32NodeResultMap">
        select * from t_esp32_node where node_id = #{nodeId}
    </select>

    <select id="selectByNodeIdAndTenantIncludeDeleted" resultMap="Esp32NodeResultMap">
        select * from t_esp32_node where tenant_id = #{tenantId} and node_id = #{nodeId}
    </select>

    <update id="restoreRetiredById">
        update t_esp32_node set del_flag = 0, status = 0, current_clients = 0, last_heartbeat = null
        where tenant_id = #{tenantId} and node_id = #{nodeId} and del_flag = 1
    </update>

    <update id="markTimedOutNodesOffline">
        update t_esp32_node set status = #{offlineStatus},current_clients = 0, update_time = CURRENT_TIMESTAMP
        where del_flag = 0 and status = #{onlineStatus} and last_heartbeat is not null and last_heartbeat <![CDATA[ <= ]]> #{cutoff}
    </update>

</mapper>
