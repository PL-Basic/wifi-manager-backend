  "conflicts": [
    {
      "id": "C-MARKET-STATE",
      "source": "historical cross-domain marketplace aliases",
      "currentTruth": "Marketplace Order and TARGET_DOMAIN/TRACK_ONLY Fulfillment use separate schema-constrained vocabularies; TARGET_DOMAIN PROCESSING is legal.",
      "resolution": "Reject PENDING_PAYMENT, COMPLETED, ATTENTION_REQUIRED, RETRY_WAIT and MANUAL_REQUIRED only in Marketplace domains; retain PROCESSING in TARGET_DOMAIN Fulfillment.",
      "targetLayer": "2.4",
      "evidence": "database-migration/src/main/resources/db/migration/V2_5_1__marketplace_demo_schema.sql"
    },
    {
      "id": "C-ANNOUNCEMENT-COMMENT-STATE",
      "source": "historical combined announcement/comment aliases",
      "currentTruth": "Announcement, Comment, CapabilityRestriction and review Outbox are separate persisted objects.",
      "resolution": "Use REVIEW_APPROVED/REVIEW_REJECTED, USER_DELETED/ADMIN_HIDDEN and the Outbox vocabulary from V2_6.",
      "targetLayer": "2.4",
      "evidence": "database-migration/src/main/resources/db/migration/V2_6__announcement_schema.sql"
    },
    {
      "id": "C-AI-STATE",
      "source": "historical AI PENDING/PROCESSING/RETRY_WAIT/CANCELLED aliases",
      "currentTruth": "AI task uses QUEUED/RUNNING/SUCCEEDED/FAILED/MANUAL_REQUIRED/STALE.",
      "resolution": "Keep aliases scoped out of AI without banning legal PROCESSING elsewhere.",
      "targetLayer": "2.4",
      "evidence": "database-migration/src/main/resources/db/migration/V2_7__ai_review_schema.sql"
    },
    {
      "id": "C-SUPPORT-ACCEPT",
      "source": "historical ACCEPTED terminal interpretation",
      "currentTruth": "ACCEPTED is compatibility-only; successful accept must atomically create Ticket, first Message and NONE->OPEN transition before persisting CONVERTED_TO_TICKET.",
      "resolution": "Do not expose ACCEPTED as the completed acceptance result.",
      "targetLayer": "2.4",
      "evidence": "database-migration/src/main/resources/db/migration/V2_8__support_ticket_schema.sql"
    },
    {
      "id": "C-ALERT-HANDLE",
      "source": "desired replay-safe duplicate alert handling",
      "currentTruth": "AlertEventServiceImpl rejects an already handled event with conflict.",
      "resolution": "ALERT-01.COMMAND.HANDLE remains PARTIAL and is uniquely assigned to 2.4.",
      "targetLayer": "2.4",
      "evidence": "monitor-service/src/main/java/com/plagod/service/impl/AlertEventServiceImpl.java"
    }
